# auto-run when starting the REPL via running `python`
# needs `export PYTHONSTARTUP=~/.pythonrc` in .bashrc.

import sys, importlib, os, subprocess

# red prompts, distinguished from .bashrc green
sys.ps1 = "\033[31m\033[1m > \033[0m"
sys.ps2 = "\033[31m\033[1m . \033[0m"

# exit shortcut `q()`
def q():
	exit()
## make `q` work as `q()`
_quit_func = q
_displayhook = sys.displayhook
def _displayhook_q(value):
	if value is _quit_func:
		q()
	_displayhook(value)
sys.displayhook = _displayhook_q

# bash shortcut
_bashdir = r"c:\\Program Files\\Git\\bin\\bash.exe" if os.name == 'nt' else "/bin/bash"
def bash(arg):
	subprocess.run([_bashdir, "-c", arg])

# import important modules by default
_importlist = ['sys', 'importlib', 'subprocess', 'os']
for alias, pkg in {"np": "numpy", "cv": "cv2", "pd": "pandas"}.items():
	try:
		globals()[alias] = importlib.import_module(pkg)
		if alias != pkg:
			_importlist += [alias + " (" + pkg + ")"]
		else:
			_importlist += [pkg]
	except:
		pass

print('Imports:', ", ".join(sorted(_importlist)))
print()
