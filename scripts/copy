#!/usr/bin/env bash

# wrapper for copying text to clipboard

helpmenu() {
	echo "... | copy [options]"
	echo ""
	echo "-h, --help        Show this help menu"
	echo "-s, --secret      Don't output text copied"
	echo "-w, --whitespace  Don't strip whitespace"
}

SHOW_OUTPUT=true
STRIP_WHITESPACE=true

while [[ $# -gt 0 ]]; do
	case "$1" in
		-h|--help)
			helpmenu
			exit 0
			;;
		-s|--secret)
			SHOW_OUTPUT=false
			;;
		-w|--whitespace)
			STRIP_WHITESPACE=false
			;;
	esac
	shift
done

if [[ "$OSTYPE" == "msys" ]]; then
	toexec="cat > /dev/clipboard"
elif hash xclip 2>/dev/null; then
	toexec="xclip -selection clipboard"
elif hash pbcopy 2>/dev/null; then
	toexec="pbcopy"
else
	echo "no known way to copy detected"
	exit 1
fi

if [ "$STRIP_WHITESPACE" = "true" ]; then
	toexec="xargs echo -n | $toexec"
fi

if [ "$SHOW_OUTPUT" = "true" ]; then
	exec tee -p >(eval "$toexec")
else
	eval "$toexec"
fi
