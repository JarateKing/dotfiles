#!/usr/bin/env bash

# grab PS1-4 raw/rendered from one interactive shell, sep-separated
export sep=$'\x1e'
capture=$(bash -ic '
	printf "%s" "$sep"
	for v in PS1 PS2 PS3 PS4; do
		printf "%s%s%s%s" "${!v}" "$sep" "${!v@P}" "$sep"
	done
' 2>/dev/null)
rest=${capture#*"$sep"}

# pops the next \x1e-delimited field off $rest into $field
next() {
	field=${rest%%"$sep"*}
	rest=${rest#*"$sep"}
}

skip_newline=true
prompts=("PS1 (general prompt)" "PS2 (continued line)" "PS3 (select prompt)" "PS4 (set -x prompt)")
for i in "${prompts[@]}"; do
	next; raw=$field
	next; rendered=${field//$'\001'/}; rendered=${rendered//$'\002'/}
	raw=${raw//$'\e'/\\e}; raw=${raw//$'\n'/\\n}

	if [ "$skip_newline" = true ]; then
		skip_newline=false
	else
		echo ""
	fi
	
	echo "$i: $raw"
	echo -e "$rendered"
	echo -ne "\e[0m"
done
